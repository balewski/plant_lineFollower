#!/bin/bash
# Interrupt the Mac operator and the Pi controller. The controller then stops the Teensy.
set -euo pipefail
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "stopPlant [--pi 10.0.0.20]"
    echo "Send SIGINT to run_operator and clock_probe on this Mac, and to controller, gpio_clock and clock_probe on the Pi."
    exit 0
fi
while [[ $# -gt 0 ]]; do
    case "$1" in
        --pi) export PI_HOST="$2"; shift 2 ;;
        *) echo "Unknown option $1" >&2; exit 1 ;;
    esac
done
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/plant_common.sh"

if pkill -INT -f "$PLANT_BIN/run_operator"; then
    echo "Interrupted Mac operator"
else
    echo "Mac operator was not running"
fi
if pkill -INT -f "$PLANT_BIN/clock_probe"; then
    echo "Interrupted Mac clock_probe"
fi

ssh_pi "pidfile='$PI_CTRL_PID' bin='$PI_BIN'
if [[ -f \$pidfile ]]; then
    pid=\$(cat \$pidfile)
    if kill -0 \$pid 2>/dev/null; then
        kill -INT \$pid
        echo \"Interrupted Pi controller \$pid\"
    else
        echo 'Pi controller was not running'
    fi
else
    echo 'Pi controller was not running'
fi
if pkill -INT -f \$bin/gpio_clock; then
    echo 'Interrupted gpio_clock'
fi
if pkill -INT -f \$bin/clock_probe; then
    echo 'Interrupted clock_probe'
fi
" || echo "Could not reach ${PI_SSH}"
