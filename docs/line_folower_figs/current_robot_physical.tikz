\begin{tikzpicture}[font=\small,>=stealth,
 part/.style={draw,thick,rounded corners,align=center,inner sep=6pt},
 note/.style={font=\small,align=left}]
\node[part,fill=gray!12,minimum width=8cm] (roof) at (0,6.6) {Removable roof: plate, rim and four columns\\Conical transitions to upper-deck brackets};
\draw[dashed] (-3.3,6.0) -- (-3.3,5.0);
\draw[dashed] (3.3,6.0) -- (3.3,5.0);
\node[part,fill=cyan!10,minimum width=8cm,minimum height=1.2cm] (upper) at (0,4.35) {Upper deck\\Teensy + clasp; power bucks; ammeter; driver mounts};
\draw[line width=5pt,orange!65!black] (-3.3,3.7) -- (-3.3,1.8);
\draw[line width=5pt,blue!60!black] (3.3,3.7) -- (3.3,1.8);
\node[part,fill=green!8,minimum width=5.3cm] at (0,2.75) {Pi Model B Plus + USB Wi-Fi\\Shared 2S battery};
\node[part,fill=gray!18,minimum width=8cm,minimum height=.65cm] (lower) at (0,1.35) {Lower deck: motor mounts, switches and cable routing};
\draw[thick,fill=black!35] (-3.5,-.2) rectangle (-2.5,.9);
\draw[thick,fill=black!35] (2.5,-.2) rectangle (3.5,.9);
\node at (0,.4) {Two driven wheels + rear caster};
\node[part,fill=purple!8] (sensor) at (-6,1.35) {Front sensor head\\A / B / C};
\draw[thick] (sensor.east) -- (lower.west);
\draw[->,thick] (-6,.8) -- (-6,-.5);
\draw[thick] (-7,-.5) -- (4.2,-.5);
\node[note,anchor=west] at (4.2,3.0) {Braced front\\and aft pillars};
\draw[->] (4.1,3.0) -- (3.45,3.0);
\node[font=\scriptsize,below] at (-6,-.5) {Floor / tape};
\end{tikzpicture}
